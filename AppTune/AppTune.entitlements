<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox enabled for App Store distribution -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    
    <!-- Allow outgoing network connections -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Allow AppleScript automation -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Allow reading app data -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    
    <!-- Temporary exception to send Apple Events to Music app -->
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.apple.Music</string>
        <string>com.spotify.client</string>
    </array>
</dict>
</plist>
